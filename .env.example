# Pooled Neon connection string. Never commit a real value.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full"

# Unpooled Neon connection string used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Reserved for later Clerk staff authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# Enables the synthetic role switch only in local development.
COMPASS_ENABLE_DEV_ACCESS="true"